{
  "openapi": "3.1.0",
  "info": {
    "title": "MCP Server API (JSON-RPC)",
    "description": "API untuk mengeksekusi tools MCP menggunakan protokol JSON-RPC standar.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://inggris-sma.vercel.app"
    }
  ],
  "paths": {
    "/api/mcp": {
      "post": {
        "operationId": "callMcpTool",
        "summary": "Panggil Tool MCP",
        "description": "Endpoint utama untuk memanggil tools MCP. Harus menggunakan format JSON-RPC 2.0.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "enum": ["2.0"]
                  },
                  "method": {
                    "type": "string",
                    "enum": ["tools/call"]
                  },
                  "params": {
                    "type": "object",
                    "oneOf": [
                      {
                        "title": "create_material",
                        "description": "Buat materi atau soal baru untuk minggu tertentu.",
                        "properties": {
                          "name": {
                            "type": "string",
                            "enum": ["create_material"]
                          },
                          "arguments": {
                            "type": "object",
                            "properties": {
                              "week_id": { "type": "string" },
                              "class_id": { "type": "string" },
                              "skill_type": { "type": "string", "enum": ["reading", "writing", "listening", "speaking"] },
                              "content": { "type": "string" },
                              "metadata": { "type": "object" }
                            },
                            "required": ["week_id", "class_id", "skill_type", "content"]
                          }
                        },
                        "required": ["name", "arguments"]
                      },
                      {
                        "title": "get_pending_materials",
                        "description": "Ambil daftar materi dengan status DRAFT yang menunggu review.",
                        "properties": {
                          "name": {
                            "type": "string",
                            "enum": ["get_pending_materials"]
                          },
                          "arguments": {
                            "type": "object",
                            "properties": {
                              "class_id": { "type": "string" }
                            }
                          }
                        },
                        "required": ["name", "arguments"]
                      },
                      {
                        "title": "publish_material",
                        "description": "Publikasikan materi (ubah status DRAFT menjadi PUBLISHED).",
                        "properties": {
                          "name": {
                            "type": "string",
                            "enum": ["publish_material"]
                          },
                          "arguments": {
                            "type": "object",
                            "properties": {
                              "material_id": { "type": "string" }
                            },
                            "required": ["material_id"]
                          }
                        },
                        "required": ["name", "arguments"]
                      },
                      {
                        "title": "grade_writing_submission",
                        "description": "Ambil rubrik (berikan submission_id saja) ATAU simpan nilai tulisan siswa (berikan ai_scores & ai_feedback).",
                        "properties": {
                          "name": {
                            "type": "string",
                            "enum": ["grade_writing_submission"]
                          },
                          "arguments": {
                            "type": "object",
                            "properties": {
                              "submission_id": { "type": "string" },
                              "ai_scores": {
                                "type": "object",
                                "additionalProperties": { "type": "number" }
                              },
                              "ai_feedback": { "type": "string" }
                            },
                            "required": ["submission_id"]
                          }
                        },
                        "required": ["name", "arguments"]
                      },
                      {
                        "title": "approve_grade",
                        "description": "Setujui nilai tulisan siswa (ubah status DRAFT menjadi APPROVED).",
                        "properties": {
                          "name": {
                            "type": "string",
                            "enum": ["approve_grade"]
                          },
                          "arguments": {
                            "type": "object",
                            "properties": {
                              "grade_id": { "type": "string" }
                            },
                            "required": ["grade_id"]
                          }
                        },
                        "required": ["name", "arguments"]
                      }
                    ]
                  }
                },
                "required": ["jsonrpc", "method", "params"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respon JSON-RPC yang berisi hasil dari pemanggilan tool."
          }
        }
      }
    }
  }
}
